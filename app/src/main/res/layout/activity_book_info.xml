<?xml version="1.0" encoding="utf-8"?>
<!--
  图书详情（档案风）。
  版式对应 Wenku8 的图书详情页：顶部编号 / 封面 + 档案信息 / 01 SYNOPSIS 简介 /
  02 CONTENTS 目录 / 底部毛玻璃"继续阅读"胶囊。
  所有原有控件 id 全部保留（arc_view、bg_book、ll_info、fl_action 等），
  避免 BookInfoActivity 的绑定代码失效。
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bg_book"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/bg_image"
        android:scaleType="centerCrop"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent" />

    <io.legado.app.ui.widget.image.ArcView
        android:id="@+id/arc_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/vw_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        android:orientation="vertical">

        <io.legado.app.ui.widget.TitleBar
            android:id="@+id/title_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:title="@string/archive_book_info" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/refresh_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <io.legado.app.ui.widget.NoChildScrollNestedScrollView
                    android:id="@+id/scroll_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:fillViewport="true"
                    android:paddingBottom="100dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/ll_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="8dp"
                        android:paddingLeft="20dp"
                        android:paddingRight="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <androidx.cardview.widget.CardView
                                android:id="@+id/iv_cover_c"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:cardCornerRadius="3dp"
                                app:cardElevation="0dp">

                                <io.legado.app.ui.widget.image.CoverImageView
                                    android:id="@+id/iv_cover"
                                    android:layout_width="108dp"
                                    android:layout_height="152dp"
                                    android:contentDescription="@string/img_cover"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/image_cover_default" />

                            </androidx.cardview.widget.CardView>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="16dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tv_name"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:includeFontPadding="false"
                                    android:lineSpacingExtra="3dp"
                                    android:maxLines="2"
                                    android:text="@string/book_name"
                                    android:textColor="@color/primaryText"
                                    android:textSize="20sp"
                                    android:textStyle="bold" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/tv_author"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:minHeight="48dp"
                                        android:gravity="center_vertical"
                                        android:ellipsize="end"
                                        android:includeFontPadding="false"
                                        android:maxLength="14"
                                        android:singleLine="true"
                                        android:text="@string/author"
                                        android:textColor="@color/secondaryText"
                                        android:textSize="12sp" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="4dp"
                                        android:includeFontPadding="false"
                                        android:text="\u203a"
                                        android:textColor="@color/secondaryText"
                                        android:textSize="12sp" />

                                </LinearLayout>

                                <TextView
                                    android:id="@+id/tv_lasted"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:ellipsize="end"
                                    android:fontFamily="monospace"
                                    android:includeFontPadding="false"
                                    android:letterSpacing="0.04"
                                    android:singleLine="true"
                                    android:textColor="@color/secondaryText"
                                    android:textSize="11sp"
                                    tools:text="已完结 · 1824 章" />

                                <TextView
                                    android:id="@+id/tv_archive_code"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp"
                                    android:background="@drawable/bg_archive_code_badge"
                                    android:fontFamily="monospace"
                                    android:includeFontPadding="false"
                                    android:letterSpacing="0.08"
                                    android:paddingLeft="7dp"
                                    android:paddingTop="3dp"
                                    android:paddingRight="7dp"
                                    android:paddingBottom="3dp"
                                    android:textColor="@color/archive_code_badge_text"
                                    android:textSize="9sp"
                                    tools:text="WK-2085368447" />

                            </LinearLayout>

                        </LinearLayout>

                        <io.legado.app.ui.widget.LabelsBar
                            android:id="@+id/lb_kind"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:visibility="gone"
                            app:alignItems="center"
                            app:flexDirection="row"
                            app:flexWrap="wrap" />

                        <LinearLayout
                            android:id="@+id/ll_extra"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingTop="4dp">

                                <ImageView
                                    android:id="@+id/iv_web"
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_marginEnd="6dp"
                                    android:contentDescription="@string/origin_format"
                                    android:src="@drawable/ic_web_outline"
                                    app:tint="@color/secondaryText" />

                                <TextView
                                    android:id="@+id/tv_origin"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:ellipsize="end"
                                    android:includeFontPadding="false"
                                    android:singleLine="true"
                                    android:textColor="@color/secondaryText"
                                    android:textSize="12sp" />

                                <io.legado.app.ui.widget.text.AccentBgTextView
                                    android:id="@+id/tv_change_source"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:paddingLeft="5dp"
                                    android:paddingRight="5dp"
                                    android:text="@string/change_origin"
                                    android:textSize="12sp"
                                    app:radius="2dp" />

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingTop="4dp">

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_marginEnd="6dp"
                                    android:contentDescription="@string/group_s"
                                    android:src="@drawable/ic_groups"
                                    app:tint="@color/secondaryText" />

                                <TextView
                                    android:id="@+id/tv_group"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:ellipsize="end"
                                    android:includeFontPadding="false"
                                    android:singleLine="true"
                                    android:textColor="@color/secondaryText"
                                    android:textSize="12sp" />

                                <io.legado.app.ui.widget.text.AccentBgTextView
                                    android:id="@+id/tv_change_group"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:paddingLeft="5dp"
                                    android:paddingRight="5dp"
                                    android:text="@string/change_group"
                                    android:textSize="12sp"
                                    app:radius="2dp" />

                            </LinearLayout>

                            <ImageView
                                android:id="@+id/ic_book_last"
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:visibility="gone" />

                        </LinearLayout>

                        <!-- 01 / SYNOPSIS -->

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="26dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:includeFontPadding="false"
                                android:letterSpacing="0.16"
                                android:text="01 / SYNOPSIS"
                                android:textColor="@color/secondaryText"
                                android:textSize="8sp" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:background="@color/divider" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/book_intro"
                            android:textColor="@color/primaryText"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <FrameLayout
                            android:id="@+id/tv_intro_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp" />

                        <io.legado.app.ui.widget.text.AccentTextView
                            android:id="@+id/tv_intro_toggle"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:layout_gravity="end"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:minWidth="48dp"
                            android:paddingHorizontal="12dp"
                            android:text="@string/book_intro_expand"
                            android:textSize="12sp"
                            android:visibility="gone"
                            tools:visibility="visible" />

                        <!-- 02 / CONTENTS -->

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="22dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:includeFontPadding="false"
                                android:letterSpacing="0.16"
                                android:text="02 / CONTENTS"
                                android:textColor="@color/secondaryText"
                                android:textSize="8sp" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:background="@color/divider" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/archive_toc_title"
                                android:textColor="@color/primaryText"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_toc"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:includeFontPadding="false"
                                android:singleLine="true"
                                android:textColor="@color/secondaryText"
                                android:textSize="10sp"
                                tools:text="共 1824 章" />

                            <TextView
                                android:id="@+id/tv_toc_view"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:gravity="center_vertical"
                                android:background="?attr/selectableItemBackground"
                                android:clickable="true"
                                android:focusable="true"
                                android:includeFontPadding="false"
                                android:paddingLeft="8dp"
                                android:paddingTop="4dp"
                                android:paddingRight="2dp"
                                android:paddingBottom="4dp"
                                android:text="@string/view_toc"
                                android:textColor="@color/accent"
                                android:textSize="12sp" />

                        </LinearLayout>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rv_contents"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:paddingBottom="72dp"
                            android:clipToPadding="false"
                            android:overScrollMode="never"
                            android:scrollbars="none"
                            tools:itemCount="6"
                            tools:listitem="@layout/item_book_info_toc" />

                        <!-- 目录预览的出口：滑到最后一行也不会以为"只到这儿"，点整行进完整目录 -->
                        <LinearLayout
                            android:id="@+id/ll_toc_more"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:minHeight="46dp"
                            android:orientation="horizontal"
                            android:paddingStart="0dp"
                            android:paddingEnd="8dp"
                            android:visibility="gone"
                            tools:visibility="visible">

                            <TextView
                                android:id="@+id/tv_toc_more_hint"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:includeFontPadding="false"
                                android:singleLine="true"
                                android:ellipsize="end"
                                android:textColor="@color/secondaryText"
                                android:textSize="10sp"
                                tools:text="仅显示前 12 章 · 共 964 章" />

                            <TextView
                                android:id="@+id/tv_toc_more_action"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:includeFontPadding="false"
                                android:text="@string/toc_view_all"
                                android:textColor="@color/accent"
                                android:textSize="12sp" />

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/ll_toc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone" />

                        <!--
                          底部预留只留一处：scroll_view 的 paddingBottom（100dp ≈ 操作栏 60dp + 16dp 外边距 + 24dp 呼吸）。
                          这里原本还有一块 88dp 占位，两处叠加等于滚到底空出 116dp，往下大片空白。
                        -->

                    </LinearLayout>

                </io.legado.app.ui.widget.NoChildScrollNestedScrollView>

            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

            <io.legado.app.ui.widget.anima.RefreshProgressBar
                android:id="@+id/refresh_progress_bar"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_gravity="top" />

            <!--
              底部渐隐遮罩：让滚动内容在操作栏前淡出，文字不会从半透明按钮后透出来。
              高度收到 106dp（原来 150dp）：再高会把 100dp 处的「查看全部」页脚一起蒙掉，
              看起来像 disabled；剩下的遮盖缺口由操作栏自身 tint 补。
            -->
            <View
                android:id="@+id/vw_bottom_scrim"
                android:layout_width="match_parent"
                android:layout_height="106dp"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_archive_bottom_scrim"
                android:clickable="false"
                android:focusable="false" />

            <FrameLayout
                android:id="@+id/fl_action"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_gravity="bottom"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="16dp">

                <io.legado.app.ui.widget.archive.ArchiveFrostedView
                    android:id="@+id/fl_action_frost"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="6dp"
                    android:paddingRight="6dp">

                    <TextView
                        android:id="@+id/tv_shelf"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_archive_pill_ghost"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:minWidth="64dp"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:text="@string/remove_from_bookshelf"
                        android:textColor="@color/secondaryText"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_read"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_archive_pill"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="@string/reading"
                        android:textColor="@color/primaryText"
                        android:textSize="14sp" />

                </LinearLayout>

            </FrameLayout>

        </FrameLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
