<?xml version="1.0" encoding="utf-8"?>
<!--
  主页底部胶囊专用的半透明渐隐层。
  与 bg_archive_bottom_scrim 的区别：终点色带 alpha，让下方列表色块透上来，
  供 ArchiveFrostedView 采样成毛玻璃；详情页仍用原不透明版本盖住章节文字。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:centerColor="@color/nav_scrim_glass"
        android:centerY="0.42"
        android:endColor="@color/nav_scrim_glass"
        android:startColor="@android:color/transparent"
        android:type="linear" />
</shape>
