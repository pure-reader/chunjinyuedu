<?xml version="1.0" encoding="utf-8"?>
<!--
  Wenku8 "档案 / 编辑体" 亮色配色。
  覆盖 legado app/src/main/res/values/colors.xml，键名与原文件一一对应，
  不新增键、不删除键，直接替换即可编译。
  来源数值：Wenku8_Flutter/lib/archive_design.dart + lib/app_palette.dart(seed 0xff607d71)
-->
<resources>
    <color name="primary">#3A3A36</color>
